# Copie este arquivo para ".env" e ajuste. Valores abaixo são apenas exemplos (nada secreto).
PORT=3000
MAX_PARTICIPANTS=6
# Origens extras autorizadas (separadas por vírgula). Vazio = somente a mesma origem.
ALLOWED_ORIGINS=
# Defina como true quando estiver atrás de proxy/HTTPS da hospedagem (Render, Railway, Nginx...)
TRUST_PROXY=false
STUN_URLS=stun:stun.l.google.com:19302
# TURN (opcional, mas necessário em muitas redes corporativas/4G). Preencha com os dados do seu provedor.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Limite de criar/entrar em salas por IP
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
